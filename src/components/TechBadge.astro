---
const { name, devicon, color } = Astro.props;
---

<div class="group flex flex-col items-center justify-center gap-y-2 p-3 sm:p-4 bg-surface rounded-md w-20 h-20 sm:w-24 sm:h-24 mx-auto transition-all duration-300 hover:scale-105 hover:border-accent hover:shadow-lg hover:shadow-accent/10 border border-border cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent/50" tabindex="0">
  <i class={`${devicon} text-2xl sm:text-3xl transition-transform duration-300 group-hover:scale-110`} style={`color: ${color}`}></i>
  <span class="text-xs sm:text-sm text-center text-muted transition-colors duration-300 group-hover:text-text">{name}</span>
</div>
